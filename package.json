{
  "name": "margo-inline",
  "displayName": "Margo Inline \u2014 Private Code Annotations",
  "description": "Private code notes displayed as end-of-line annotations without modifying source files. Categories, resolve/reopen, filtering, and Markdown/HTML export.",
  "version": "0.2.1",
  "publisher": "ignorantshr",
  "author": {
    "name": "ignorantshr",
    "url": "https://github.com/ignorantshr"
  },
  "license": "AGPL-3.0-only",
  "icon": "images/margo-inline.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/ignorantshr/margo"
  },
  "homepage": "https://github.com/ignorantshr/margo#readme",
  "bugs": {
    "url": "https://github.com/ignorantshr/margo/issues"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "margo",
    "code notes",
    "annotations",
    "comments",
    "review",
    "todo",
    "ai",
    "llm",
    "copilot",
    "ai prompt",
    "documentation",
    "productivity",
    "private notes",
    "inline notes"
  ],
  "galleryBanner": {
    "color": "#17243D",
    "theme": "dark"
  },
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "configuration": {
      "title": "Margo Inline",
      "properties": {
        "margoInline.defaultAuthor": {
          "type": "string",
          "default": "",
          "description": "Default author name for new notes. Leave empty to use the OS username."
        },
        "margoInline.defaultCategory": {
          "type": "string",
          "enum": [
            "todo",
            "bug",
            "note"
          ],
          "default": "note",
          "description": "Default category for new notes."
        },
        "margoInline.confirmDelete": {
          "type": "boolean",
          "default": true,
          "description": "Show a confirmation dialog before deleting a note."
        },
        "margoInline.showStatusBar": {
          "type": "boolean",
          "default": true,
          "description": "Show the note count in the status bar."
        },
        "margoInline.treeGroupBy": {
          "type": "string",
          "enum": [
            "file",
            "category",
            "status"
          ],
          "enumDescriptions": [
            "Group notes by file path",
            "Group notes by category (TODO, BUG, etc.)",
            "Group notes by status (Open, Resolved)"
          ],
          "default": "category",
          "description": "Default grouping mode for the notes tree view."
        },
        "margoInline.showResolvedNotes": {
          "type": "boolean",
          "default": true,
          "description": "Show resolved notes in the editor and tree view."
        },
        "margoInline.lineTracking": {
          "type": "boolean",
          "default": true,
          "description": "Automatically adjust note positions when lines are added or removed."
        }
      }
    },
    "commands": [
      {
        "command": "margoInline.addNote",
        "title": "Add Note",
        "icon": "$(add)"
      },
      {
        "command": "margoInline.createNote",
        "title": "Save Note",
        "icon": "$(check)"
      },
      {
        "command": "margoInline.saveNote",
        "title": "Save"
      },
      {
        "command": "margoInline.cancelNote",
        "title": "Cancel"
      },
      {
        "command": "margoInline.discardNote",
        "title": "Discard",
        "icon": "$(close)"
      },
      {
        "command": "margoInline.deleteNote",
        "title": "Delete Note",
        "icon": "$(trash)"
      },
      {
        "command": "margoInline.editNote",
        "title": "Edit",
        "icon": "$(edit)"
      },
      {
        "command": "margoInline.editProperties",
        "title": "Edit Category",
        "icon": "$(settings-gear)"
      },
      {
        "command": "margoInline.resolveNote",
        "title": "Resolve",
        "icon": "$(check)"
      },
      {
        "command": "margoInline.unresolveNote",
        "title": "Reopen",
        "icon": "$(circle-outline)"
      },
      {
        "command": "margoInline.resolveNoteFromTree",
        "title": "Resolve Note",
        "icon": "$(check)"
      },
      {
        "command": "margoInline.unresolveNoteFromTree",
        "title": "Reopen Note",
        "icon": "$(circle-outline)"
      },
      {
        "command": "margoInline.setCategoryTodo",
        "title": "Set Category: \ud83d\udccb TODO"
      },
      {
        "command": "margoInline.setCategoryBug",
        "title": "Set Category: \ud83d\udc1b BUG"
      },
      {
        "command": "margoInline.setCategoryNote",
        "title": "Set Category: \ud83d\udcdd NOTE"
      },
      {
        "command": "margoInline.refreshTree",
        "title": "Refresh Notes",
        "icon": "$(refresh)"
      },
      {
        "command": "margoInline.switchGroupBy",
        "title": "Group By\u2026",
        "icon": "$(list-tree)"
      },
      {
        "command": "margoInline.groupByFile",
        "title": "Group by File"
      },
      {
        "command": "margoInline.groupByCategory",
        "title": "Group by Category"
      },
      {
        "command": "margoInline.groupByStatus",
        "title": "Group by Status"
      },
      {
        "command": "margoInline.filterNotes",
        "title": "Filter Notes\u2026",
        "icon": "$(filter)"
      },
      {
        "command": "margoInline.clearFilter",
        "title": "Clear Filters",
        "icon": "$(clear-all)"
      },
      {
        "command": "margoInline.exportMarkdown",
        "title": "Export Notes to Markdown",
        "icon": "$(markdown)"
      },
      {
        "command": "margoInline.exportHtml",
        "title": "Export Notes to HTML",
        "icon": "$(file-code)"
      },
      {
        "command": "margoInline.copyAsAiPrompt",
        "title": "Copy as AI Prompt",
        "icon": "$(clippy)"
      },
      {
        "command": "margoInline.goToNote",
        "title": "Go to Note"
      },
      {
        "command": "margoInline.deleteNoteFromTree",
        "title": "Delete Note",
        "icon": "$(trash)"
      },
      {
        "command": "margoInline.armDeleteNote",
        "title": "Delete Note",
        "icon": "$(trash)"
      },
      {
        "command": "margoInline.confirmDeleteNote",
        "title": "Confirm Delete",
        "icon": "$(error)"
      }
    ],
    "keybindings": [
      {
        "command": "margoInline.addNote",
        "key": "ctrl+shift+n",
        "mac": "cmd+shift+a",
        "when": "editorTextFocus"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "margoInline",
          "title": "Margo Inline",
          "icon": "images/activity.svg"
        }
      ]
    },
    "views": {
      "margoInline": [
        {
          "id": "margoInlineExplorer",
          "name": "Notes Explorer",
          "icon": "$(comment-discussion)",
          "contextualTitle": "Margo Inline"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "margoInlineExplorer",
        "contents": "No notes yet.\n\nAdd a note by right-clicking on a line in the editor or using the keyboard shortcut:\n[Add Note](command:margoInline.addNote)\n\nOr press Ctrl+Shift+N (Cmd+Shift+A on Mac)"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "margoInline.addNote",
          "group": "navigation@1",
          "when": "editorTextFocus"
        }
      ],
      "view/title": [
        {
          "command": "margoInline.switchGroupBy",
          "when": "view == margoInlineExplorer",
          "group": "navigation@0"
        },
        {
          "command": "margoInline.filterNotes",
          "when": "view == margoInlineExplorer",
          "group": "navigation@1"
        },
        {
          "command": "margoInline.refreshTree",
          "when": "view == margoInlineExplorer",
          "group": "navigation@2"
        },
        {
          "command": "margoInline.clearFilter",
          "when": "view == margoInlineExplorer",
          "group": "navigation@3"
        },
        {
          "command": "margoInline.exportMarkdown",
          "when": "view == margoInlineExplorer",
          "group": "export@1"
        },
        {
          "command": "margoInline.exportHtml",
          "when": "view == margoInlineExplorer",
          "group": "export@2"
        },
        {
          "command": "margoInline.copyAsAiPrompt",
          "when": "view == margoInlineExplorer",
          "group": "export@3"
        }
      ],
      "view/item/context": [
        {
          "command": "margoInline.deleteNoteFromTree",
          "when": "view == margoInlineExplorer && viewItem =~ /^note/",
          "group": "inline@1"
        }
      ],
      "comments/commentThread/context": [
        {
          "command": "margoInline.createNote",
          "group": "inline@1",
          "when": "commentController == margoInline && commentThreadIsEmpty"
        },
        {
          "command": "margoInline.discardNote",
          "group": "inline@2",
          "when": "commentController == margoInline && commentThreadIsEmpty"
        },
        {
          "command": "margoInline.setCategoryTodo",
          "group": "2_category@1",
          "when": "commentController == margoInline && !commentThreadIsEmpty"
        },
        {
          "command": "margoInline.setCategoryBug",
          "group": "2_category@2",
          "when": "commentController == margoInline && !commentThreadIsEmpty"
        },
        {
          "command": "margoInline.setCategoryNote",
          "group": "2_category@5",
          "when": "commentController == margoInline && !commentThreadIsEmpty"
        },
        {
          "command": "margoInline.resolveNote",
          "group": "3_status@1",
          "when": "commentController == margoInline && !commentThreadIsEmpty"
        },
        {
          "command": "margoInline.unresolveNote",
          "group": "3_status@2",
          "when": "commentController == margoInline && !commentThreadIsEmpty"
        }
      ],
      "comments/comment/title": [
        {
          "command": "margoInline.resolveNote",
          "group": "inline@2",
          "when": "commentController == margoInline && comment =~ /^margoInlineNote(Local|Team)$/"
        },
        {
          "command": "margoInline.unresolveNote",
          "group": "inline@2",
          "when": "commentController == margoInline && comment =~ /^margoInlineNoteResolved(Local|Team)$/"
        },
        {
          "command": "margoInline.editNote",
          "group": "inline@3",
          "when": "commentController == margoInline && comment =~ /^margoInlineNote(Local|Team|ResolvedLocal|ResolvedTeam)$/"
        },
        {
          "command": "margoInline.armDeleteNote",
          "group": "inline@4",
          "when": "commentController == margoInline && comment =~ /^margoInlineNote(Local|Team|ResolvedLocal|ResolvedTeam)$/"
        },
        {
          "command": "margoInline.confirmDeleteNote",
          "group": "inline@4",
          "when": "commentController == margoInline && comment =~ /Armed$/"
        },
        {
          "command": "margoInline.editProperties",
          "group": "inline@0",
          "when": "commentController == margoInline && comment =~ /^margoInlineNote(Local|Team|ResolvedLocal|ResolvedTeam)$/"
        }
      ],
      "comments/comment/context": [
        {
          "command": "margoInline.saveNote",
          "group": "inline@0",
          "when": "commentController == margoInline && comment =~ /^margoInlineNote/"
        },
        {
          "command": "margoInline.cancelNote",
          "group": "inline@1",
          "when": "commentController == margoInline && comment =~ /^margoInlineNote/"
        }
      ]
    },
    "colors": [
      {
        "id": "margoInline.deleteConfirm",
        "description": "Color for delete confirmation button",
        "defaults": {
          "dark": "#f44336",
          "light": "#d32f2f"
        }
      },
      {
        "id": "margoInline.inlineNoteForeground",
        "description": "Foreground color for Margo Inline end-of-line note labels and text.",
        "defaults": {
          "dark": "#BCAED0",
          "light": "#BCAED0",
          "highContrast": "#FFFFFF",
          "highContrastLight": "#342268"
        }
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile",
    "test": "node ./out/test/runTest.js",
    "lint": "eslint src",
    "package": "vsce package",
    "publish:vscode": "vsce publish",
    "publish:openvsx": "ovsx publish",
    "publish:all": "npm run publish:vscode && npm run publish:openvsx",
    "test:unit": "npm run compile && mocha --ui tdd out/test/suite/utils.test.js && node --test test/*.test.cjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@types/mocha": "^10.0.10",
    "@types/node": "^20.x",
    "@types/vscode": "^1.85.0",
    "@typescript-eslint/eslint-plugin": "^6.x",
    "@typescript-eslint/parser": "^6.x",
    "@vscode/test-electron": "^2.5.2",
    "@vscode/vsce": "^3.0.0",
    "eslint": "^8.57.1",
    "globals": "^16.5.0",
    "mocha": "^11.3.0",
    "ovsx": "^0.10.0",
    "typescript": "^5.3.0"
  }
}
